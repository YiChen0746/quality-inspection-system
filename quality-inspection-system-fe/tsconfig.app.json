{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue","*.ts","*.tsx"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "composite": true,
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "allowImportingTsExtensions": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@Common/*": ["./src/common/*"],
      "@Components/*": ["./src/components/*"],
      "@Router/*": ["./src/router/*"],
      "@Setup/*": ["./src/setup/*"],
      "@Stores/*": ["./src/stores/*"],
      "@Views/*": ["./src/views/*"]
    }
  }
}
