# 依赖包目录
node_modules/

# 打包输出目录
dist/
dist-ssr
coverage
*.tsbuildinfo

# 日志文件
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 编辑器目录和文件
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 环境变量文件
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 临时文件
.temp
.tmp

# 用户上传文件（含真实合同/病例数据，不发布，程序运行时会自动创建目录）
**/public/uploads/*
# 例外：国家市场监督管理总局合同示范文本库的公开样例
!**/public/uploads/samples/
!**/public/uploads/samples/*.docx

# 本地保留、不发布的旧版后端
quality-inspection-system-server/

# 备份/禁用的 git 目录
.git_disabled/

# 本地临时快照与一次性脚本（同步队友代码时的备份、截图、排查脚本，不发布）
_backup_*/
_fixed_snapshot/
_review_remote/
_shots/
**/_cleanup.js
**/_getcode.js
