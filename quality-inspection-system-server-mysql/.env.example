# 后端环境变量示例
# 用法（3 步）：
#   1. 复制本文件，重命名为 .env（注意 .env 不会提交到仓库，每个人自己建）
#   2. 修改下面的 DB_PASSWORD 为你本机的 MySQL 密码
#   3. 修改下面的 LLM_API_KEY 为你自己的智谱 key（https://open.bigmodel.cn 免费注册获取）
# 不配 LLM_API_KEY 也能启动服务，但合同生成/审查/风险评分等 AI 功能会报错。

# ---------- 服务端口 ----------
PORT=3000

# ---------- 数据库 ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=quality_inspection

# ---------- 会话密钥 ----------
# 生产环境务必改成一个随机长字符串，例如：openssl rand -hex 32
SESSION_SECRET=quality_inspection_secret

# ---------- JWT 登录令牌 ----------
# 签发与校验共用，生产环境务必改成随机长字符串
JWT_SECRET=your-secret-key
JWT_EXPIRES_IN=7d

# ---------- 跨域白名单 ----------
# 允许跨域访问后端的前端来源，逗号分隔；留空表示仅允许同源（推荐：前端经 Vite 代理或 Nginx 反代访问，无需配置）
# 示例：CORS_ORIGINS=http://localhost:5173,http://172.20.10.3:5173
CORS_ORIGINS=

# ---------- 邮件服务（发送注册/找回密码验证码）----------
SMTP_SERVICE=qq
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASS=your_smtp_auth_code

# ---------- 大模型（OpenAI 兼容服务，任选一家，代码自动读取 LLM_*）----------
# 方案A：智谱 GLM-4-Flash（永久免费，推荐）—— key 在 https://open.bigmodel.cn 注册后获取
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=your_zhipu_key
LLM_MODEL=glm-4-flash

# 方案B：硅基流动（注册送额度，部分小模型免费）—— https://cloud.siliconflow.cn
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_API_KEY=your_siliconflow_key
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# 方案C：DeepSeek 官方（需账户余额，欠费会报 402）
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=your_deepseek_api_key
# LLM_MODEL=deepseek-chat

# 兼容旧变量名（如果上面 LLM_* 没配置，会读取这两个）
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_API_KEY=your_deepseek_api_key

# ---------- 智能质检：讯飞 OCR ----------
OCR_APP_ID=your_xfyun_app_id
OCR_API_SECRET=your_xfyun_api_secret
OCR_API_KEY=your_xfyun_api_key
OCR_HOST=api.xf-yun.com
OCR_URL_PATH=/v1/private/sf8e6aca1
